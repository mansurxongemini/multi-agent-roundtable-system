# ╔══════════════════════════════════════════════════════════════╗
# ║  AI SOCIETY SIMULATION — Environment configuration             ║
# ║  Copy to `.env` and fill in real values. NEVER commit `.env`.  ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (SQLite) ────────────────────────────────────────────
# Optional: override the SQLite file location. Defaults to ./db.sqlite3
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# ── Redis (Channels layer + Celery broker) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API-key encryption ───────────────────────────────────────────
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key

# ── Optional: bootstrap provider keys (only used by seed command) ─
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
